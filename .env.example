# Safe default: no live provider call.
HOST=127.0.0.1
PORT=4173
PATHASETU_MODEL_PROVIDER=mock
# To enable Groq deliberately, set PATHASETU_MODEL_PROVIDER=groq and add GROQ_API_KEY.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# For a public HTTPS demo with a live provider, use NODE_ENV=production, a random
# PATHASETU_DEMO_ACCESS_CODE of at least 16 characters, and an access-controlled tunnel.
# If demo draft content is still needed, explicitly use PATHASETU_ALLOW_DRAFT_DEMO=true.
# Do not expose a live-provider proxy without a proper access control layer.

# Basic in-memory per-client-IP API limits; these reset when the process restarts.
PATHASETU_RATE_WINDOW_MS=60000
PATHASETU_SESSION_RATE_LIMIT=30
PATHASETU_RECHECK_RATE_LIMIT=24

# Optional: exact public origins allowed to POST when a tunnel or reverse proxy rewrites the Host header
# (comma-separated; https only, or http for localhost; no paths, no wildcards). Prefer a proxy that preserves Host.
# PATHASETU_ALLOWED_ORIGINS=https://your-demo-host.example

# Public / tunnel demo mode (fail-closed). Set to exactly "true" or "false"; any other value stops startup.
# When true, startup refuses unless PATHASETU_DEMO_ACCESS_CODE is a random value of at least 16 characters
# (no spaces, not repetitive, not sequential), whatever the provider or NODE_ENV. Session, pack and re-check then all need the code.
# Generate one locally:  node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# This is lightweight demo protection for a private tunnel, not production-grade authentication.
# PATHASETU_PUBLIC_DEMO=false
# PATHASETU_DEMO_ACCESS_CODE=
# Failed or missing-code attempts allowed per client per window before 429 "too many attempts". It is a window that
# expires; a request with the correct code is never refused by it.
# PATHASETU_FAILED_ATTEMPT_LIMIT=20

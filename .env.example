# Safe default: no live provider call.
HOST=127.0.0.1
PORT=4173
PATHASETU_MODEL_PROVIDER=mock
# To enable Groq deliberately, set PATHASETU_MODEL_PROVIDER=groq and add GROQ_API_KEY.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=
# For a public HTTPS demo with a live provider, use NODE_ENV=production, a random
# PATHASETU_DEMO_ACCESS_CODE of at least 16 characters, and an access-controlled tunnel.
# If demo draft content is still needed, explicitly use PATHASETU_ALLOW_DRAFT_DEMO=true.
# Do not expose a live-provider proxy without a proper access control layer.

# Basic in-memory per-client-IP API limits; these reset when the process restarts.
PATHASETU_RATE_WINDOW_MS=60000
PATHASETU_SESSION_RATE_LIMIT=30
PATHASETU_RECHECK_RATE_LIMIT=24

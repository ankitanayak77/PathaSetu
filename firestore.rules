rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function guardian(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function validAttempt(attemptId) {
      let data = request.resource.data;
      return attemptId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.keys().hasOnly(['schemaVersion', 'itemId', 'optionId', 'submittedAt', 'diagnosisType', 'misconceptionId'])
        && data.keys().hasAll(['schemaVersion', 'itemId', 'optionId', 'submittedAt', 'diagnosisType', 'misconceptionId'])
        && data.schemaVersion == 1
        && data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 100
        && data.optionId is string && data.optionId.size() > 0 && data.optionId.size() <= 32
        && data.submittedAt is string
        && data.submittedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && data.diagnosisType in ['MISCONCEPTION', 'NONE', 'UNCERTAIN']
        && (data.diagnosisType == 'MISCONCEPTION'
          ? (data.misconceptionId is string && data.misconceptionId.matches('^[A-Za-z0-9_-]{1,100}$'))
          : data.misconceptionId == null);
    }

    match /guardians/{uid}/learners/{learnerId}/attempts/{attemptId} {
      allow read: if guardian(uid)
        && learnerId.matches('^[A-Za-z0-9_-]{1,100}$');
      allow create, update: if guardian(uid)
        && learnerId.matches('^[A-Za-z0-9_-]{1,100}$')
        && validAttempt(attemptId);
      allow delete: if guardian(uid)
        && learnerId.matches('^[A-Za-z0-9_-]{1,100}$');
    }
  }
}
